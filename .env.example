# Public, build-time value. This is the ONLY contact value allowed in VITE_*.
VITE_TURNSTILE_SITE_KEY=replace-with-public-site-key

# Private runtime bindings. Set as hosting secrets; never prefix these with VITE_.
RESEND_API_KEY=replace-with-resend-sending-api-key
CONTACT_TO_EMAIL=private-inbox@example.com
CONTACT_FROM_EMAIL=portfolio@contact.example.com
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
CONTACT_ALLOWED_ORIGIN=https://www.example.com
# Generate at least 32 random characters, e.g. openssl rand -hex 32.
CONTACT_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
